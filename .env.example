# =================================================================
# UNIVERSITY OF UPPER HILL — ENVIRONMENT CONFIGURATION
# =================================================================

# Database 1: PostgreSQL 15 (Relational Data & Transactions)
POSTGRES_USER=uuh_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=uuh_db
DATABASE_URL=postgres://uuh_admin:change_me_in_production@db:5432/uuh_db

# Database 2: MongoDB 6.0 (Document Store & Audit Logs)
MONGO_URI=mongodb://mongo:27017/uuh_cms
MONGO_NOTIFICATIONS_URI=mongodb://mongo:27017/uuh_notifications

# Auth & Cryptography
JWT_SECRET=change_me_to_a_random_64_char_string
REFRESH_SECRET=change_me_to_another_random_64_char_string
DOWNLOAD_SECRET=change_me_for_admission_letters

# Jiunge / Pesaflow Payment Gateway (Finance Service)
JIUNGE_API_URL=https://api.jiunge.example.com
JIUNGE_API_KEY=your_jiunge_api_key
JIUNGE_WEBHOOK_SECRET=your_jiunge_webhook_secret

# SMTP Mail Server (Notification Service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@upperhill.ac.ke
SMTP_PASS=your_smtp_password

# Internal Microservice URLs (Inside Docker Network)
AUTH_SERVICE_URL=http://auth-service:3001
ACADEMIC_SERVICE_URL=http://academic-service:3002
HOSTEL_SERVICE_URL=http://hostel-service:3003
FINANCE_SERVICE_URL=http://finance-service:3004
ADMISSIONS_SERVICE_URL=http://admissions-service:3005
CMS_SERVICE_URL=http://cms-service:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3007

# General
NODE_ENV=development
